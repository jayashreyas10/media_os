# Database Configuration
# Local SQLite default: "file:./dev.db"
# Production PostgreSQL (Supabase / Railway): "postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# Session & Authentication Secret (minimum 32 characters)
SESSION_SECRET="mediaos-dev-session-secret-change-in-production-must-be-32-chars"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# AI Provider Configuration ("mock" | "gemini" | "openai" | "anthropic")
AI_PROVIDER_DEFAULT="mock"

# Optional External AI API Keys (Not required in Mock mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Application Port
PORT=3000
