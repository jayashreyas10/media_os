# ==============================================================================
# MediaOS Production Environment Configuration Template
# Copy this file to .env or configure these variables in your deployment dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Set to 'production' in deployed environments; 'development' locally.
NODE_ENV=production

# The port the Next.js server listens on (automatically provided by Railway/hosting)
PORT=3000

# Canonical public origin of the deployed application (HTTPS required for live OAuth)
# Example: https://mediaos-production.up.railway.app
APP_URL=https://mediaos-production.up.railway.app
NEXT_PUBLIC_APP_URL=https://mediaos-production.up.railway.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string for production. SQLite file:./dev.db supported for local dev/testing.
# When postgresql:// is detected, MediaOS automatically adapts the Prisma datasource provider.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host.railway.internal:5432/railway

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Cryptographic secret used for session tokens and cookie integrity.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_FOR_SESSION_SECURITY

# 32-byte AES-256-GCM encryption key for zero-leakage token storage (access & refresh tokens).
# Must be exactly 64 hex characters or 32-byte UTF-8 string.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=GENERATE_A_RANDOM_64_CHAR_HEX_STRING_FOR_TOKEN_ENCRYPTION

# ------------------------------------------------------------------------------
# 4. AI CAPABILITIES & OPERATIONAL MODE
# ------------------------------------------------------------------------------
# Set to 'true' to completely disable all AI provider invocations and mock generators.
# When true, all automated workflows run 100% manually, and AI triggers return HTTP 503.
AI_DISABLED=true

# Preferred default provider when AI is enabled: 'mock' | 'openai' | 'anthropic' | 'gemini'
AI_PROVIDER_DEFAULT=disabled

# Live AI Provider Keys (Optional: when provided, LIVE provider is activated)
# OPENAI_API_KEY=sk-proj-YOUR_KEY
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY
# GEMINI_API_KEY=AIzaSyYOUR_KEY

# ------------------------------------------------------------------------------
# 5. OAUTH PROVIDERS (LIVE SOCIAL & CONTENT CHANNELS)
# ------------------------------------------------------------------------------
# If omitted or if AI_PROVIDER_DEFAULT=mock, MediaOS safely uses deterministic
# mock providers explicitly labeled with [MOCK / DEMONSTRATION MODE].
# When configured, ensure your developer consoles whitelist the callback URL:
# ${APP_URL}/api/oauth/[platform]/callback

# YouTube / Google Data API v3
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# YOUTUBE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# X / Twitter API v2 (OAuth 2.0 with PKCE)
# TWITTER_CLIENT_ID=YOUR_TWITTER_CLIENT_ID
# TWITTER_CLIENT_SECRET=YOUR_TWITTER_CLIENT_SECRET
# X_CLIENT_ID=YOUR_TWITTER_CLIENT_ID
# X_CLIENT_SECRET=YOUR_TWITTER_CLIENT_SECRET

# LinkedIn OAuth 2.0
# LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
# LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
